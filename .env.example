# Live Solana discovery + enrichment
BIRDEYE_API_KEY=
BIRDEYE_POLL_MS=10000
BIRDEYE_MAX_RPM=50
DISCOVERY_BATCH_SIZE=10
MAX_TRACKED_TOKENS=3

# Pump.fun native backend fallback for coins that DexScreener/Birdeye have not indexed yet.
# Read-only. Does not build, sign, or broadcast transactions.
PUMP_NATIVE_MAX_PER_CYCLE=4
PUMP_NATIVE_MIN_GAP_MS=450
PUMP_NATIVE_CACHE_MS=8000
PUMP_NATIVE_TIMEOUT_MS=4000
# Optional extra read-only RPC. Defaults already include Solana Tracker/PublicNode/public mainnet.
SOLANA_PROFILE_RPC_URL=
# Primary fresh-token holder distribution path via Helius getTokenAccounts.
HELIUS_HOLDER_CACHE_MS=10000
HELIUS_HOLDER_COOLDOWN_MS=10000
HELIUS_HOLDER_TIMEOUT_MS=4000

# Helius WebSocket wakeups / RPC enrichment
HELIUS_API_KEY=
HELIUS_WS_ENABLED=true
HELIUS_PROGRAM_IDS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
HELIUS_TRIGGER_MIN_MS=1500
HELIUS_STALE_AFTER_MS=75000
DIRECT_CREATE_HYDRATION_CONCURRENCY=4
DIRECT_CREATE_HYDRATION_BACKLOG=96

# Supabase server-side persistence
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Telegram owner + private subscriber alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LANGUAGE=ar

# Scanner thresholds
MIN_LIQUIDITY_USD=8000
ENTRY_SCORE_THRESHOLD=82
MOON_SCORE_THRESHOLD=88
MAX_TOKEN_AGE_SECONDS=300

# Durable worker recovery
RUNTIME_CHECKPOINT_MS=15000
RUNTIME_MAX_REPLAY_BLOCKS=500
RUNTIME_PENDING_MAX_AGE_MS=900000

# Birdeye Smart Money engine (legacy/rollback path)
SMART_MONEY_ENABLED=false
SMART_MONEY_WALLET_POLL_MS=5000
SMART_MONEY_DISCOVERY_POLL_MS=60000
SMART_MONEY_INTERVAL=1d
SMART_MONEY_TRADER_STYLE=trenchers
SMART_MONEY_MAX_CANDIDATES=5
SMART_MONEY_TOP_TRADERS_PER_TOKEN=3
SMART_MONEY_MAX_WALLETS=6
SMART_MONEY_MIN_NET_FLOW_USD=5000
SMART_MONEY_MIN_TRADERS=3
SMART_MONEY_MIN_BUY_SELL_RATIO=1.25
SMART_MONEY_MAX_MARKET_CAP_USD=3000000
SMART_MONEY_MIN_WALLET_WIN_RATE=0.55
SMART_MONEY_MIN_WALLET_REALIZED_PNL_USD=1000
SMART_MONEY_MIN_WALLET_SCORE=60
SMART_MONEY_ELITE_WALLET_SCORE=82
SMART_MONEY_ELITE_WALLET_WIN_RATE=0.65
SMART_MONEY_MIN_CONFIRMING_WALLETS=2
SMART_MONEY_CLUSTER_WINDOW_MS=120000
SMART_MONEY_CANDIDATE_TTL_MS=600000
SMART_MONEY_WALLET_SCORE_CACHE_MS=1800000
SMART_MONEY_SIGNAL_COOLDOWN_MS=900000
SMART_MONEY_MAX_RISK_SCORE=30

# Paper portfolio
PAPER_STARTING_USD=1000
PAPER_TRADE_SIZE_USD=25
MAX_OPEN_POSITIONS=2
PAPER_STOP_LOSS_PCT=22
# Solana Ultra -> durable candidate funnel + PAPER trading only.
# This bridge never enables live execution.
SOLANA_PAPER_BRIDGE_ENABLED=true
SOLANA_PAPER_MIN_SCORE=72
# PAPER ONLY: allows a smaller probe when holder providers are temporarily pending.
SOLANA_PAPER_PROBE_MIN_SCORE=68
# PAPER ONLY: stale provider-pending probes free their slot after this time unless promoted.
SOLANA_PAPER_PROBE_MAX_HOLD_MS=1200000
# Reserve at least one PAPER slot for fully-qualified candidates when MAX_OPEN_POSITIONS=2.
SOLANA_PAPER_MAX_PROBES=1
# Keep stale checkpoint backlog from delaying fresh Pump.fun candidates.
SOLANA_PENDING_MAX_AGE_MS=480000
PEAK_HUNTER_START_PCT=200

# Real-money engine remains locked by default.
# BOTH gates must be true for the Telegram Manual Confirm path to broadcast.
LIVE_TRADING_ENABLED=false
MANUAL_TRADING_ARMED=false
# Emergency stop: set true to block confirmations even if both gates are armed.
MANUAL_EXECUTION_KILL_SWITCH=false

# Manual-confirm hard caps (Solana production path)
MANUAL_MAX_BUY_SOL=0.01
MANUAL_MAX_SLIPPAGE_BPS=300
MANUAL_MAX_PRICE_IMPACT_PCT=2
MANUAL_MAX_FEE_BPS=100
MANUAL_CONFIRM_TTL_MS=30000
MANUAL_MIN_SOL_RESERVE=0.05
MANUAL_MAX_TRADES_PER_DAY=6
MANUAL_MAX_DAILY_BUY_SOL=0.05

# Final execution safety gate — rechecked immediately before signing
MANUAL_MIN_LIQUIDITY_USD=8000
MANUAL_MAX_5M_MOVE_PCT=50
MANUAL_MAX_TOP_USER_PCT=12
MANUAL_MAX_TOP5_PCT=35
MANUAL_MAX_TOP10_PCT=50

# Optional one-shot-style startup smoke. Must only be used while LIVE_TRADING_ENABLED=false.
# Verifies Privy wallet/auth, balance read, and Jupiter quote without transaction build/sign/send.
LIVE_READONLY_SMOKE_ON_START=false

# Independent protection for manually-confirmed Solana live positions.
# Monitoring runs even while broadcast is locked. Automatic EXIT broadcast requires
# LIVE_TRADING_ENABLED=true; MANUAL_TRADING_ARMED continues to control new manual entries only.
LIVE_PROTECTION_POLL_MS=1500
LIVE_PROTECTION_MARKET_REFRESH_MS=3000
LIVE_PROTECTION_QUOTE_REFRESH_MS=3000
LIVE_PROTECTION_SECURITY_REFRESH_MS=20000
LIVE_PROTECTION_STOP_LOSS_PCT=10
LIVE_PROTECTION_TRAIL_START_PCT=12
LIVE_PROTECTION_TRAIL_PCT=8
LIVE_PROTECTION_TIGHT_TRAIL_START_PCT=35
LIVE_PROTECTION_TIGHT_TRAIL_PCT=5
LIVE_PROTECTION_PROFIT_LOCK_TRIGGER_PCT=30
LIVE_PROTECTION_PROFIT_LOCK_FLOOR_PCT=20
LIVE_PROTECTION_MIN_LIQUIDITY_USD=2000
LIVE_PROTECTION_LIQUIDITY_COLLAPSE_RATIO=0.25
LIVE_PROTECTION_SELLABILITY_FAILURES=2
LIVE_PROTECTION_QUOTE_SLIPPAGE_BPS=700
# Ambiguous post-broadcast outcomes are reconciled before any fresh sell attempt.
LIVE_PROTECTION_UNCERTAINTY_GRACE_MS=60000
LIVE_PROTECTION_RISK_SIGNAL_MAX_AGE_MS=120000

# Existing live engine bounds
LIVE_POLL_MS=7000
LIVE_ENTRY_PERCENT=10
LIVE_MAX_ENTRY_SOL=0.05
LIVE_MIN_ENTRY_SOL=0.005
LIVE_MIN_SOL_RESERVE=0.03
LIVE_MAX_OPEN_POSITIONS=1
LIVE_STOP_LOSS_PCT=10
LIVE_PROFIT_LOCK_TRIGGER_PCT=30
LIVE_PROFIT_LOCK_FLOOR_PCT=20
PUMPPORTAL_SLIPPAGE_PCT=10
PUMPPORTAL_PRIORITY_FEE_SOL=0.00005
